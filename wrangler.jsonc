{
  "name": "playrixtest",
  "main": "cloudflare/visitor-entry.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playrixtest-db",
      "database_id": "11ec038b-156d-42de-9ac8-fec35f439a07"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "playrixtest-artifacts"
    }
  ],
  "queues": {
    "producers": [{ "binding": "IMAGE_JOBS", "queue": "playrixtest-image-jobs" }],
    "consumers": [{
      "queue": "playrixtest-image-jobs",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_retries": 0,
      "max_concurrency": 1
    }]
  },
  "assets": {
    "directory": "cloudflare/visitor-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "LIVE_GENERATION_ENABLED": "false",
    "LIVE_PLANNER_ENABLED": "false"
  }
}
