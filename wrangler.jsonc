{
  "name": "playrixtest",
  "main": "cloudflare/visitor-entry.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playrixtest-db",
      "database_id": "11ec038b-156d-42de-9ac8-fec35f439a07"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "playrixtest-artifacts"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMAGE_JOBS",
        "queue": "playrixtest-image-jobs"
      },
      {
        "binding": "FINAL_JOBS",
        "queue": "playrixtest-finalization"
      }
    ],
    "consumers": [
      {
        "queue": "playrixtest-image-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 0,
        "max_concurrency": 1
      },
      {
        "queue": "playrixtest-finalization",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4,
        "max_concurrency": 1
      }
    ]
  },
  "assets": {
    "directory": "cloudflare/visitor-public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "LIVE_GENERATION_ENABLED": "true",
    "GUEST_PAID_GENERATION_ENABLED": "true",
    "LIVE_PLANNER_ENABLED": "true",
    "GUEST_IMAGE_RESERVATION_NANODOLLARS": "1000000000",
    "GUEST_TEXT_RESERVATION_NANODOLLARS": "1000000000"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "build": {
    "command": "npm run check"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
