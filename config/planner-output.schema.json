{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "art_direction_version",
    "art_direction_sha256",
    "assumptions",
    "collections"
  ],
  "properties": {
    "art_direction_version": {
      "type": "string"
    },
    "art_direction_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "source",
          "reason"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "source": {
            "enum": [
              "user",
              "design_requirement",
              "planner_inference"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "collection_id",
          "name",
          "coherence_rationale",
          "objects"
        ],
        "properties": {
          "collection_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "coherence_rationale": {
            "type": "string"
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "object_id",
                "main_identity",
                "theme_role",
                "material_color",
                "object_brief",
                "contents",
                "decoration",
                "attached_components",
                "loose_accessories",
                "structural_features",
                "deferred_context",
                "user_locks",
                "assumptions",
                "detail_budget",
                "camera_plan",
                "production_category",
                "asset_stage",
                "semantic_family",
                "living_creatures",
                "factual_checks",
                "composition_key"
              ],
              "properties": {
                "object_id": {
                  "type": "string"
                },
                "main_identity": {
                  "type": "string"
                },
                "theme_role": {
                  "type": "string"
                },
                "material_color": {
                  "type": "string"
                },
                "object_brief": {
                  "type": "string"
                },
                "contents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "decoration": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "attached_components": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "loose_accessories": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "structural_features": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "deferred_context": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "user_locks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "description",
                      "source",
                      "reason"
                    ],
                    "properties": {
                      "description": {
                        "type": "string"
                      },
                      "source": {
                        "enum": [
                          "user",
                          "design_requirement",
                          "planner_inference"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    }
                  }
                },
                "detail_budget": {
                  "type": "object",
                  "required": [
                    "level",
                    "rationale"
                  ],
                  "properties": {
                    "level": {
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "rationale": {
                      "type": "string"
                    }
                  }
                },
                "camera_plan": {
                  "type": "object",
                  "required": [
                    "projection",
                    "elevation",
                    "component_coherence"
                  ],
                  "properties": {
                    "projection": {
                      "type": "string"
                    },
                    "elevation": {
                      "type": "string"
                    },
                    "component_coherence": {
                      "type": "string"
                    }
                  }
                },
                "production_category": {
                  "enum": [
                    "C1",
                    "C2",
                    "C3",
                    "C4"
                  ]
                },
                "asset_stage": {
                  "enum": [
                    "foreground_only",
                    "object_with_surface",
                    "whole_card"
                  ]
                },
                "semantic_family": {
                  "type": "string",
                  "enum": [
                    "instrument",
                    "audio_equipment",
                    "clothing_accessory",
                    "printed_material",
                    "recorded_media",
                    "furniture",
                    "container",
                    "tool",
                    "lighting",
                    "architecture",
                    "decoration",
                    "food",
                    "game",
                    "transport",
                    "other"
                  ]
                },
                "living_creatures": {
                  "type": "string",
                  "enum": [
                    "none"
                  ]
                },
                "factual_checks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "composition_key": {
                  "enum": [
                    "upright-offset",
                    "low-diagonal",
                    "top-down-spread",
                    "horizontal-closeup",
                    "frontal-symmetric",
                    "three-quarter-wide",
                    "foreground-to-depth",
                    "corner-perspective",
                    "curved-silhouette",
                    "layered-detail"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
